# Production Environment Configuration
aws_region = "us-east-1"

# Amazon Connect Configuration
connect_instance_alias  = "prod-connect-instance"
connect_instance_name   = "prod-connect"

# S3 Configuration
# Note: S3 bucket names must be globally unique. Append a unique identifier if needed.
s3_bucket_name = "prod-connect-recordings"

# Environment Configuration
environment = "prod"
